;\nfor (var s in inside) { Push(names, s.StationName + ' (' + s.stationId + ')') }\nreturn { type: 'text', text:\n  '<table style=\"width:100%;font-size:12px\"><tr><th align=\"left\">Index</th><th>FDRA avg</th><th>Avg pct</th><th>Class</th></tr>'\n  + rows + '</table><p style=\"font-size:11px\">' + n + ' RAWS: ' + Concatenate(names, ', ') + '</p>' };\n", "returnType": "dictionary"}}]}}, {"id": "raws", "title": "RAWS – ERC percentile (today)", "url": "https://services3.arcgis.com/T4QMspbfLg3qTGWY/arcgis/rest/services/CA_NFDRS/FeatureServer/0", "itemId": "8c98d879e6c74d07ac6236c0bfa114a3", "layerType": "ArcGISFeatureLayer", "visibility": true, "opacity": 1, "layerDefinition": {"drawingInfo": {"renderer": {"type": "uniqueValue", "valueExpression": "var p = $feature.ERC_Pct; When(IsEmpty(p), 'No data', p >= 97, 'Critical', p >= 95, 'High', p >= 90, 'Elevated', 'Normal')", "valueExpressionTitle": "Station ERC alert", "defaultSymbol": {"type": "esriSMS", "style": "esriSMSCircle", "color": [154, 160, 180, 255], "size": 7, "outline": {"type": "esriSLS", "style": "esriSLSSolid", "color": [30, 30, 30, 255], "width": 0.7}}, "defaultLabel": "No data", "uniqueValueInfos": [{"value": "Critical", "label": "Critical (≥ 97th pct)", "symbol": {"type": "esriSMS", "style": "esriSMSCircle", "color": [255, 45, 85, 255], "size": 7, "outline": {"type": "esriSLS", "style": "esriSLSSolid", "color": [30, 30, 30, 255], "width": 0.7}}}, {"value": "High", "label": "High (≥ 95th)", "symbol": {"type": "esriSMS", "style": "esriSMSCircle", "color": [255, 107, 0, 255], "size": 7, "outline": {"type": "esriSLS", "style": "esriSLSSolid", "color": [30, 30, 30, 255], "width": 0.7}}}, {"value": "Elevated", "label": "Elevated (≥ 90th)", "symbol": {"type": "esriSMS", "style": "esriSMSCircle", "color": [255, 204, 0, 255], "size": 7, "outline": {"type": "esriSLS", "style": "esriSLSSolid", "color": [30, 30, 30, 255], "width": 0.7}}}, {"value": "Normal", "label": "Normal (< 90th)", "symbol": {"type": "esriSMS", 